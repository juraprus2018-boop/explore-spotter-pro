<IfModule mod_mime.c>
  # JavaScript modules
  AddType application/javascript .js
  AddType application/javascript .mjs
  
  # TypeScript
  AddType application/x-typescript .ts
  AddType application/x-typescript .tsx
  
  # JSON
  AddType application/json .json
  
  # CSS
  AddType text/css .css
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Serve sitemap.xml from edge function
  RewriteRule ^sitemap\.xml$ https://htpnlpmktvmswzkhkfwy.supabase.co/functions/v1/generate-sitemap [R=302,L]
  

  # Don't rewrite files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Rewrite everything else to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Enable CORS if needed
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
